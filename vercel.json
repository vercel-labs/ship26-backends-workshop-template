{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "ui": {
      "root": "ui"
    },
    "backend": {
      "root": "backend"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "ui" } }
  ]
}
